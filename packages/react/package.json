{
  "name": "@open-tw/icon-picker-react",
  "version": "0.1.0",
  "description": "React adapter for @open-tw/icon-picker-core (React 18 and 19).",
  "keywords": [
    "icon-picker",
    "headless",
    "icons",
    "react",
    "react-hooks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-tw/icon-picker.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/open-tw/icon-picker/tree/main/packages/react#readme",
  "bugs": "https://github.com/open-tw/icon-picker/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@open-tw/icon-picker-core": "workspace:*"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
