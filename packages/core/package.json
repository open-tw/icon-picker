{
  "name": "@open-tw/icon-picker-core",
  "version": "0.2.0",
  "description": "Headless, framework-agnostic icon picker core.",
  "keywords": [
    "icon-picker",
    "headless",
    "icons",
    "lucide",
    "combobox",
    "a11y"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-tw/icon-picker.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/open-tw/icon-picker/tree/main/packages/core#readme",
  "bugs": "https://github.com/open-tw/icon-picker/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "publishConfig": {
